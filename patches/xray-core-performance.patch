diff --git a/common/buf/readv_single_test.go b/common/buf/readv_single_test.go
new file mode 100644
index 0000000..379fb73
--- /dev/null
+++ b/common/buf/readv_single_test.go
@@ -0,0 +1,111 @@
+//go:build unix && !openbsd
+
+package buf
+
+import (
+	"errors"
+	"io"
+	"net"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// tcpPair returns the client end and a ReadVReader on the accepted server end.
+func tcpPair(t *testing.T) (*net.TCPConn, *ReadVReader, *net.TCPConn) {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	client, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := ln.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close(); server.Close() })
+	raw, err := server.(*net.TCPConn).SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return client.(*net.TCPConn), NewReadVReader(server, raw, nil), server.(*net.TCPConn)
+}
+
+func TestReadSingle(t *testing.T) {
+	tests := []struct {
+		name  string
+		act   func(client, server *net.TCPConn)
+		check func(t *testing.T, b *Buffer, err error)
+	}{
+		{"data arrives later", func(c, _ *net.TCPConn) {
+			go func() { time.Sleep(50 * time.Millisecond); c.Write([]byte("hello")) }()
+		}, func(t *testing.T, b *Buffer, err error) {
+			if err != nil || b.String() != "hello" {
+				t.Fatalf("got %q, %v", b.String(), err)
+			}
+		}},
+		{"peer closes", func(c, _ *net.TCPConn) { c.Close() }, func(t *testing.T, b *Buffer, err error) {
+			if b != nil || err != io.EOF {
+				t.Fatalf("got %v, %v; want nil, EOF", b, err)
+			}
+		}},
+		{"read deadline", func(_, s *net.TCPConn) { s.SetReadDeadline(time.Now().Add(50 * time.Millisecond)) },
+			func(t *testing.T, b *Buffer, err error) {
+				var ne net.Error
+				if b != nil || !errors.As(err, &ne) || !ne.Timeout() {
+					t.Fatalf("got %v, %v; want a timeout", b, err)
+				}
+			}},
+		{"peer resets", func(c, _ *net.TCPConn) { c.SetLinger(0); c.Close() }, func(t *testing.T, b *Buffer, err error) {
+			if b != nil || !errors.Is(err, syscall.ECONNRESET) {
+				t.Fatalf("got %v, %v; want ECONNRESET", b, err)
+			}
+		}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			client, r, server := tcpPair(t)
+			tt.act(client, server)
+			if tt.name == "peer resets" {
+				time.Sleep(50 * time.Millisecond) // let the RST land before reading
+			}
+			b, err := r.readSingle()
+			tt.check(t, b, err)
+			if b != nil {
+				b.Release()
+			}
+		})
+	}
+}
+
+func TestReadVReaderLargeTransfer(t *testing.T) {
+	client, r, _ := tcpPair(t)
+	want := make([]byte, 4<<20)
+	for i := range want {
+		want[i] = byte(i * 7)
+	}
+	go func() { client.Write(want); client.Close() }()
+	var got []byte
+	for {
+		mb, err := r.ReadMultiBuffer()
+		for _, b := range mb {
+			if b != nil { // like upstream, EOF from the single-buffer path comes as MultiBuffer{nil}
+				got = append(got, b.Bytes()...)
+			}
+		}
+		ReleaseMulti(mb)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if string(got) != string(want) {
+		t.Fatalf("got %d bytes, want %d (or content differs)", len(got), len(want))
+	}
+}
