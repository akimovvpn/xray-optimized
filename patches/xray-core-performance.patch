new file mode 100644
index 0000000..2dd42af
--- /dev/null
+++ b/common/buf/readv_single_unix.go
@@ -0,0 +1,58 @@
+//go:build unix && !openbsd
+
+package buf
+
+import (
+	"io"
+	"net"
+	"os"
+	"syscall"
+)
+
+// readSingle is ReadBuffer(r.Reader). For a bare TCP/Unix socket it takes the buffer from the pool only once the
+// socket is readable, so an idle connection no longer pins 8 KiB while it waits ([optimized-xray]).
+func (r *ReadVReader) readSingle() (*Buffer, error) {
+	conn, ok := r.Reader.(net.Conn)
+	switch r.Reader.(type) {
+	case *net.TCPConn, *net.UnixConn:
+	default:
+		ok = false
+	}
+	if !ok {
+		return ReadBuffer(r.Reader)
+	}
+	var b *Buffer
+	var n int
+	var errno error
+	err := r.rawConn.Read(func(fd uintptr) bool {
+		if b == nil {
+			b = New()
+		}
+		for {
+			n, errno = syscall.Read(int(fd), b.v)
+			if errno != syscall.EINTR {
+				break
+			}
+		}
+		if errno == syscall.EAGAIN {
+			b.Release() // nothing to read yet: give the buffer back while the poller waits
+			b = nil
+			return false
+		}
+		return true
+	})
+	if err == nil && errno != nil {
+		err = &net.OpError{Op: "read", Net: conn.LocalAddr().Network(), Source: conn.LocalAddr(), Addr: conn.RemoteAddr(), Err: os.NewSyscallError("read", errno)}
+	}
+	if err == nil && n == 0 {
+		err = io.EOF
+	}
+	if n > 0 {
+		b.end = int32(n)
+		return b, nil
+	}
+	if b != nil {
+		b.Release()
+	}
+	return nil, err
+}
