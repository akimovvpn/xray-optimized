diff --git a/proxy/vision_bench_test.go b/proxy/vision_bench_test.go
new file mode 100644
index 0000000..9ed052d
--- /dev/null
+++ b/proxy/vision_bench_test.go
@@ -0,0 +1,62 @@
+package proxy
+
+import (
+	"context"
+	"crypto/rand"
+	"testing"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/log"
+)
+
+// warningOnly mimics a production node: log level "warning", so debug logging is off.
+type warningOnly struct{}
+
+func (warningOnly) Handle(log.Message)     {}
+func (warningOnly) Severity() log.Severity { return log.Severity_Warning }
+
+// Uses only exported functions so the same benchmark runs on upstream code for comparison.
+
+// paddingStream mimics a fast inner-TLS download: 16 KiB records read in full 8 KiB chunks,
+// so buffers rarely end on a record boundary and Vision stays in padding mode.
+func paddingStream(n int) buf.MultiBuffer {
+	var data []byte
+	for len(data) < n*buf.Size+100 {
+		r := []byte{0x17, 0x03, 0x03, 0x40, 0x00}
+		body := make([]byte, 16384)
+		_, _ = rand.Read(body)
+		data = append(append(data, r...), body...)
+	}
+	data = data[100 : 100+n*buf.Size]
+	var mb buf.MultiBuffer
+	for len(data) > 0 {
+		b := buf.New()
+		b.Write(data[:buf.Size])
+		mb = append(mb, b)
+		data = data[buf.Size:]
+	}
+	return mb
+}
+
+// BenchmarkVisionPaddingWrite is the per-write work VisionWriter does while padding.
+func BenchmarkVisionPaddingWrite(b *testing.B) {
+	seed := []uint32{900, 500, 900, 256}
+	ctx := context.Background()
+	src := paddingStream(4)
+	log.RegisterHandler(warningOnly{})
+	b.ReportAllocs()
+	b.SetBytes(int64(src.Len()))
+	for b.Loop() {
+		mb := make(buf.MultiBuffer, len(src))
+		for i, s := range src {
+			mb[i] = buf.New()
+			mb[i].Write(s.Bytes())
+		}
+		_ = IsCompleteRecord(mb)
+		mb = ReshapeMultiBuffer(ctx, mb)
+		for i, x := range mb {
+			mb[i] = XtlsPadding(x, CommandPaddingContinue, nil, false, ctx, seed)
+		}
+		buf.ReleaseMulti(mb)
+	}
+}
diff --git a/proxy/vision_opt_test.go b/proxy/vision_opt_test.go
new file mode 100644
index 0000000..8905bdd
--- /dev/null
+++ b/proxy/vision_opt_test.go
@@ -0,0 +1,199 @@
+package proxy
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"testing"
+
+	"github.com/xtls/xray-core/common/buf"
+)
+
+// isCompleteRecordUpstream is the v26.11.9 implementation, kept as the reference.
+func isCompleteRecordUpstream(buffer buf.MultiBuffer) bool {
+	b := make([]byte, buffer.Len())
+	if buffer.Copy(b) != int(buffer.Len()) {
+		panic("impossible bytes allocation")
+	}
+	headerLen, recordLen, totalLen, i := 5, 0, len(b), 0
+	for i < totalLen {
+		if headerLen > 0 {
+			data := b[i]
+			i++
+			switch headerLen {
+			case 5:
+				if data != 0x17 {
+					return false
+				}
+			case 4, 3:
+				if data != 0x03 {
+					return false
+				}
+			case 2:
+				recordLen = int(data) << 8
+			case 1:
+				recordLen = recordLen | int(data)
+			}
+			headerLen--
+		} else if recordLen > 0 {
+			if totalLen-i < recordLen {
+				return false
+			}
+			i += recordLen
+			recordLen = 0
+			headerLen = 5
+		} else {
+			return false
+		}
+	}
+	return headerLen == 5 && recordLen == 0
+}
+
+func record(n int) []byte {
+	r := []byte{0x17, 0x03, 0x03, byte(n >> 8), byte(n)}
+	return append(r, bytes.Repeat([]byte{0xAA}, n)...)
+}
+
+// split cuts data into buffers at the given offsets (taken modulo the remaining length).
+func split(data []byte, cuts []byte) buf.MultiBuffer {
+	var mb buf.MultiBuffer
+	for _, c := range cuts {
+		if len(data) == 0 {
+			break
+		}
+		n := min(int(c)%(len(data)+1), buf.Size)
+		b := buf.New()
+		b.Write(data[:n])
+		mb = append(mb, b)
+		data = data[n:]
+	}
+	for len(data) > 0 {
+		n := min(len(data), buf.Size)
+		b := buf.New()
+		b.Write(data[:n])
+		mb = append(mb, b)
+		data = data[n:]
+	}
+	return mb
+}
+
+func TestIsCompleteRecord(t *testing.T) {
+	cat := func(parts ...[]byte) []byte { return bytes.Join(parts, nil) }
+	tests := []struct {
+		name string
+		data []byte
+		cuts []byte
+		want bool
+	}{
+		{"empty", nil, nil, true},
+		{"one record", record(100), nil, true},
+		{"two records", cat(record(100), record(3000)), nil, true},
+		{"record split across buffers", cat(record(100), record(3000)), []byte{3, 50, 200}, true},
+		{"header split across buffers", cat(record(10), record(10)), []byte{17, 1, 1}, true},
+		{"truncated body", record(100)[:80], nil, false},
+		{"truncated header", cat(record(10), record(10)[:3]), nil, false},
+		{"zero-length record", []byte{0x17, 0x03, 0x03, 0, 0}, nil, false},
+		{"not application data", []byte{0x16, 0x03, 0x03, 0, 1, 0}, nil, false},
+		{"bad version", []byte{0x17, 0x03, 0x01, 0, 1, 0}, nil, false},
+		{"trailing garbage", cat(record(10), []byte{0x17}), nil, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			mb := split(tt.data, tt.cuts)
+			defer buf.ReleaseMulti(mb)
+			if got := IsCompleteRecord(mb); got != tt.want {
+				t.Errorf("IsCompleteRecord() = %v, want %v", got, tt.want)
+			}
+			if ref := isCompleteRecordUpstream(mb); ref != tt.want {
+				t.Fatalf("reference disagrees with the test table: %v", ref)
+			}
+		})
+	}
+}
+
+func FuzzIsCompleteRecord(f *testing.F) {
+	f.Add(record(100), []byte{7, 200})
+	f.Add(append(record(5), record(9000)...), []byte{1, 2, 3, 255})
+	f.Fuzz(func(t *testing.T, data []byte, cuts []byte) {
+		mb := split(data, cuts)
+		defer buf.ReleaseMulti(mb)
+		if got, want := IsCompleteRecord(mb), isCompleteRecordUpstream(mb); got != want {
+			t.Fatalf("IsCompleteRecord() = %v, upstream = %v", got, want)
+		}
+	})
+}
