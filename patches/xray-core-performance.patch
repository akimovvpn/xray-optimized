+
+func TestXtlsPaddingRange(t *testing.T) {
+	seed := []uint32{900, 500, 900, 256}
+	for range 2000 {
+		for _, content := range []int32{0, 100, 1000, 8000} {
+			b := buf.New()
+			b.Extend(content)
+			out := XtlsPadding(b, CommandPaddingContinue, nil, true, context.Background(), seed)
+			h := out.BytesTo(5)
+			gotContent := int32(h[1])<<8 | int32(h[2])
+			pad := int32(h[3])<<8 | int32(h[4])
+			maxPad := int32(buf.Size - 21 - content)
+			if gotContent != content || pad < 0 || pad > maxPad || out.Len() != 5+content+pad {
+				t.Fatalf("content=%d header=%v len=%d", content, h, out.Len())
+			}
+			if content < 900 && pad < min(900-content, maxPad) { // long padding is at least seed[2]-content
+				t.Fatalf("long padding too short: content=%d pad=%d", content, pad)
+			}
+			out.Release()
+		}
+	}
+}
+
+// streamBuffers mimics a fast inner-TLS download: 16 KiB records read in full 8 KiB chunks,
+// so buffers rarely end on a record boundary and Vision stays in padding mode.
+func streamBuffers(n int) buf.MultiBuffer {
+	var data []byte
+	for len(data) < n*buf.Size+100 {
+		r := record(16384)
+		_, _ = rand.Read(r[5:])
+		data = append(data, r...)
+	}
+	return split(data[100:100+n*buf.Size], nil)
+}
+
+func BenchmarkIsCompleteRecord(b *testing.B) {
+	mb := streamBuffers(4)
+	b.Run("upstream", func(b *testing.B) {
+		b.ReportAllocs()
+		for b.Loop() {
+			isCompleteRecordUpstream(mb)
+		}
+	})
+	b.Run("optimized", func(b *testing.B) {
+		b.ReportAllocs()
+		for b.Loop() {
+			IsCompleteRecord(mb)
+		}
+	})
+}
